# =============================================================================
# PrivShield Docker Compose 生产环境变量模板 (.env.prod.example)
# =============================================================================
# 生产环境使用说明：
#   1. 复制此文件为 .env:
#      cp .env.prod.example .env
#   2. 生成并配置强密码与密钥（不要提交到 Git 仓库）
#   3. 准备证书文件 deploy/docker-compose/certs/tls.crt 与 tls.key
#
# 基础服务配置
PRIVACY_LOG_LEVEL=INFO
PRIVACY_LOG_FORMAT=json

# 生产安全配置：TLS
PRIVACY_TLS_ENABLED=true
PRIVACY_TLS_CERT_FILE=/certs/tls.crt
PRIVACY_TLS_KEY_FILE=/certs/tls.key
PRIVACY_TLS_CLIENT_AUTH=none

# 生产安全配置：API Key 认证 (JSON 映射表)
PRIVACY_AUTH_ENABLED=true
PRIVACY_AUTH_EXTERNAL_KEYS_JSON={"prod-gateway-key":{"name":"gateway","scopes":["*"]},"prod-app-key":{"name":"internal-app","scopes":["mask","dp","classify"]}}

# 生产安全配置：速率限制
PRIVACY_RATE_LIMIT_ENABLED=true
PRIVACY_RATE_LIMIT_DEFAULT_RPS=50
PRIVACY_RATE_LIMIT_DEFAULT_BURST=100
PRIVACY_RATE_LIMIT_REDIS_URL=redis://redis:6379/0

# LLM 推理连接 (vLLM 容器或独立推理机)
PRIVACY_LLM_PROVIDER=vllm
LLM_API_BASE=http://vllm:8000/v1
LLM_API_KEY=EMPTY
VLLM_IMAGE_TAG=latest

# 生产监控面板 Grafana 管理员密码 (必填强密码)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=PrivShieldProd_SecurePassword2026!
