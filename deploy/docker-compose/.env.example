# =============================================================================
# PrivShield Docker Compose 开发环境变量模板 (.env.example)
# =============================================================================
# 复制此文件为 .env 并在当前目录运行 docker compose：
#   cp .env.example .env
#
# 基础服务配置
PRIVACY_LOG_LEVEL=DEBUG
PRIVACY_LOG_FORMAT=text

# LLM 后端连接配置
LLM_API_BASE=http://vllm:8000/v1
LLM_API_KEY=EMPTY
VLLM_IMAGE_TAG=latest

# 可观测性（监控）
GRAFANA_ADMIN_PASSWORD=admin
