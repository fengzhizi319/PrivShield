# ==============================================================================
# Privacy Local Agent - 运维主控配置模板 (.env.example)
# 复制此文件为 .env 即可生效: cp .env.example .env
# ==============================================================================
# 运维切换部署场景只需修改 PRIVACY_ENV_PROFILE 这一行：
# 对应自动装载 config/env/<profile>.env 场景配置文件。
#
# 可选 Profile 预设：
#   - vllm   : 独立进程 vLLM OpenAI 兼容 HTTP 服务 (自动加载 config/env/vllm.env)
#   - qwen3  : 本地 PyTorch/Transformers 嵌入模式 (自动加载 config/env/qwen3.env)
#   - mlx    : macOS Apple Silicon MLX 引擎模式 (自动加载 config/env/mlx.env)
#   - openai : 外部通用 OpenAI/Ollama API 接口模式 (自动加载 config/env/openai.env)
# ------------------------------------------------------------------------------
PRIVACY_ENV_PROFILE=vllm

# ------------------------------------------------------------------------------
# 基础服务与网络通信配置 / Base Agent Server Settings
# ------------------------------------------------------------------------------
PRIVACY_REST_HOST=127.0.0.1
PRIVACY_REST_PORT=8079
PRIVACY_GRPC_HOST=127.0.0.1
PRIVACY_GRPC_PORT=50051
PRIVACY_LOG_LEVEL=INFO
