# ==============================================================================
# Privacy Local Agent - 运行配置模板 / Environment Configuration Template
# ==============================================================================
# 使用方法：
#   cp .env.example .env
#   然后取消注释需要使用的一种 LLM 调用模式，并填写对应参数。
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 模式 1：vLLM OpenAI 兼容 HTTP API 服务 (推荐：生产环境 / 高并发 / 独立进程/卡池)
# 说明：通过 vLLM 启动的 OpenAI 兼容 HTTP 接口（8000 端口）进行通信。
# 对应启动脚本：./start_vllm_server.sh 或 python run_vllm_server.py
# ------------------------------------------------------------------------------
# PRIVACY_LLM_PROVIDER=vllm
# PRIVACY_LLM_API_BASE=http://127.0.0.1:8000/v1
# PRIVACY_LLM_MODEL_NAME=Qwen3.5-0.8B-Privacy-Classifier-Smoother
# PRIVACY_LLM_API_KEY=EMPTY
# PRIVACY_LLM_API_HOST=127.0.0.1
# PRIVACY_LLM_API_PORT=8000
# PRIVACY_LLM_MODEL_PATH=.models/Qwen3.5-0.8B-Privacy-Classifier-Smoother
# PRIVACY_VLLM_GPU_MEMORY_UTILIZATION=0.90

# ------------------------------------------------------------------------------
# 模式 2：本地 PyTorch + Transformers 部署 (默认单机本地模式 / CUDA 或 CPU)
# 说明：在 Agent 进程内部直接使用 PyTorch/Transformers 加载 HuggingFace 模型。
# ------------------------------------------------------------------------------
# PRIVACY_LLM_PROVIDER=qwen3
# PRIVACY_LLM_MODEL_PATH=.models/Qwen3.5-0.8B-Privacy-Classifier-Smoother
# PRIVACY_LLM_DEVICE=cuda

# ------------------------------------------------------------------------------
# 模式 3：本地 Apple Silicon MLX 引擎 (macOS 专属 / Metal GPU 加速)
# 说明：在 Mac 平台上使用 Apple 原生 MLX 引擎加载轻量量化模型。
# ------------------------------------------------------------------------------
# PRIVACY_LLM_PROVIDER=mlx
# PRIVACY_LLM_MODEL_PATH=.models/Qwen3.5-0.8B-Privacy-Classifier-Smoother-mlx

# ------------------------------------------------------------------------------
# 模式 4：通用 OpenAI 兼容接口 (例如 Ollama, DeepSeek API, Qwen 线上云 API)
# 说明：对接符合 OpenAI Chat Completions 规范的第三方云端或本地服务。
# ------------------------------------------------------------------------------
# PRIVACY_LLM_PROVIDER=openai
# PRIVACY_LLM_API_BASE=http://127.0.0.1:11434/v1
# PRIVACY_LLM_MODEL_NAME=qwen2.5:latest
# PRIVACY_LLM_API_KEY=ollama

# ------------------------------------------------------------------------------
# 基础服务与通信配置 / Base Agent Server Settings
# ------------------------------------------------------------------------------
PRIVACY_REST_HOST=127.0.0.1
PRIVACY_REST_PORT=8079
PRIVACY_GRPC_HOST=127.0.0.1
PRIVACY_GRPC_PORT=50051
PRIVACY_LOG_LEVEL=INFO
