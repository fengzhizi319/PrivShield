# ==============================================================================
# Privacy Local Agent - 运维主控配置模板 (.env.example)
# 复制此文件为 .env 即可生效: cp .env.example .env
# ==============================================================================
# 运维切换部署场景只需修改 PRIVACY_ENV_PROFILE 这一行：
# 对应自动装载 config/env/<profile>.env 场景配置文件。
#
# 可选 Profile 预设：
#   - vllm   : 独立进程 vLLM OpenAI 兼容 HTTP 服务 (自动加载 config/env/vllm.env)
#   - qwen3  : 本地 PyTorch/Transformers 嵌入模式 (自动加载 config/env/qwen3.env)
#   - mlx    : macOS Apple Silicon MLX 引擎模式 (自动加载 config/env/mlx.env)
#   - openai : 外部通用 OpenAI/Ollama API 接口模式 (自动加载 config/env/openai.env)
# ------------------------------------------------------------------------------
PRIVACY_ENV_PROFILE=vllm

# ------------------------------------------------------------------------------
# 基础服务与网络通信配置 / Base Agent Server Settings
# 注意：python -m privacy_local_agent.server / grpc_server / launcher 默认绑定
# 0.0.0.0；仅 python -m privacy_local_agent.main 默认 127.0.0.1。
# 本地开发建议保持 127.0.0.1；容器/集群部署需显式改为 0.0.0.0 并配合 TLS/Auth。
# ------------------------------------------------------------------------------
PRIVACY_REST_HOST=127.0.0.1
PRIVACY_REST_PORT=8079
PRIVACY_GRPC_HOST=127.0.0.1
PRIVACY_GRPC_PORT=50051
# gRPC 服务端线程池大小（默认 64）
# PRIVACY_GRPC_MAX_WORKERS=64
# REST 并发与请求数限制（uvicorn 层，默认 10000 / 100000）
# PRIVACY_LIMIT_CONCURRENCY=10000
# PRIVACY_LIMIT_MAX_REQUESTS=100000
# PRIVACY_TIMEOUT_KEEP_ALIVE=30

# ------------------------------------------------------------------------------
# 日志与可观测性 / Logging & Observability
# ------------------------------------------------------------------------------
PRIVACY_LOG_LEVEL=INFO
# 日志格式：text 或 json（生产建议 json）
# PRIVACY_LOG_FORMAT=text
# 日志/追踪中的服务名
# PRIVACY_SERVICE_NAME=privacy-local-agent
# 可选 OpenTelemetry OTLP 端点（不设置则不导出 trace）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ------------------------------------------------------------------------------
# 隐私参数 Profile 与预算 / Profile & Privacy Budget
# ------------------------------------------------------------------------------
# YAML 参数 profile 路径（仅读取其中 primitives: 段，见 config/sample-privacy-profile.yaml）
# PRIVACY_PROFILE=privacy-profile.yaml
# 个性化推荐参数文件路径
# PRIVACY_PERSONALIZED_PROFILE=config/personalized-profiles.yaml
# 隐私预算命名空间（多租户隔离）
# PRIVACY_NAMESPACE=default
# SQLite 预算库路径（多实例部署必须设置；不设置则为单进程内存模式）
# PRIVACY_BUDGET_DB=privacy_budget.db
# 预算自动重置时间窗口（秒，不设置则不自动重置）
# PRIVACY_BUDGET_WINDOW_SECONDS=86400
# 预算审计日志路径 / 审计 HMAC 密钥（生产建议配置）
# PRIVACY_BUDGET_AUDIT_LOG=logs/privacy_budget_audit.log
# PRIVACY_AUDIT_KEY=

# ------------------------------------------------------------------------------
# 安全：TLS / API Key 认证 / 速率限制 / Security
# 详见 docs/production_security/ops.md
# ------------------------------------------------------------------------------
# PRIVACY_TLS_ENABLED=false
# PRIVACY_TLS_CERT_FILE=/certs/tls.crt
# PRIVACY_TLS_KEY_FILE=/certs/tls.key
# mTLS：CA 证书路径与客户端认证模式（none/optional/require）
# PRIVACY_TLS_CA_FILE=/certs/ca.crt
# PRIVACY_TLS_CLIENT_AUTH=none
# 私钥加密时的口令
# PRIVACY_TLS_KEY_PASSWORD=
# API Key 认证（默认关闭）
# PRIVACY_AUTH_ENABLED=false
# 外部调用方 API Key，JSON 对象：{"<api-key>": {"name": "...", "scopes": ["*"]}}
# PRIVACY_AUTH_EXTERNAL_KEYS_JSON={"dev-key":{"name":"local","scopes":["*"]}}
# 内部服务间 API Key（同格式）
# PRIVACY_AUTH_INTERNAL_KEYS_JSON=
# 内部 mTLS 身份认证（默认关闭，fail-closed）与客户端 CN 白名单
# PRIVACY_AUTH_INTERNAL_MTLS_ENABLED=false
# mTLS CN 白名单 YAML 配置文件路径（设置后 PRIVACY_AUTH_MTLS_ALLOWED_CNS 被忽略）
# PRIVACY_AUTH_MTLS_WHITELIST_FILE=config/mtls-whitelist.yaml
# PRIVACY_AUTH_MTLS_ALLOWED_CNS=gateway,secretpad
# 速率限制（默认关闭）
# PRIVACY_RATE_LIMIT_ENABLED=false
# PRIVACY_RATE_LIMIT_DEFAULT_RPS=10
# PRIVACY_RATE_LIMIT_DEFAULT_BURST=20
# 按端点覆盖限速，JSON 对象：{"/v1/privacy/dp/query": {"rps": 1, "burst": 2}}
# PRIVACY_RATE_LIMIT_PER_ENDPOINT_JSON=
# 分布式限速后端（不设置则进程内限速）
# PRIVACY_RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
# 健康检查端点免认证/免限速（默认 true，K8s 探针依赖）
# PRIVACY_HEALTH_NO_AUTH=true
# PRIVACY_HEALTH_NO_RATE_LIMIT=true

# ------------------------------------------------------------------------------
# 动态分类分级漏斗（Layer-1 规则 → Layer-2 NER → Layer-3 LLM）
# ------------------------------------------------------------------------------
# 启用 Layer-2 Small-NER 实体识别（默认 false，需先下载 NER 模型）
# PRIVACY_NER_ENABLE=false
# 显式启用 Layer-3 LLM 层（默认 false；不启用时仅在低置信/冲突时按仲裁策略触发）
# PRIVACY_LLM_ENABLE=false
# 检测到图片/DICOM 输入时自动触发多模态 LLM 层（默认 true）
# PRIVACY_LLM_AUTO_ON_IMAGE=true
# 低置信或冲突时启用 LLM 仲裁（默认 true，需 ML 依赖）
# PRIVACY_LLM_ENABLE_ARBITRATION=true
# 触发 Layer-3 的置信度阈值（默认 0.75）
# PRIVACY_LLM_CONFIDENCE_THRESHOLD=0.75
# Layer-1 规则引擎字段评估 LRU 缓存容量（默认 4096）
# PRIVACY_ENGINE_CACHE_MAX_SIZE=4096
# 分类结果 LRU 缓存容量（默认 10000）
# PRIVACY_CLASSIFICATION_CACHE_SIZE=10000
# 分类规则目录 / 热重载开关与间隔（秒，0=禁用轮询）
# PRIVACY_DYNCLASSIFICATION_RULES_DIR=rules
# PRIVACY_DYNCLASSIFICATION_HOT_RELOAD=true
# PRIVACY_DYNCLASSIFICATION_RELOAD_INTERVAL=0

# ------------------------------------------------------------------------------
# LLM 资源保护与推理 / LLM Guardrails
# ------------------------------------------------------------------------------
# 进程级 LLM 推理并发上限（信号量，默认 1，防止 OOM）
# PRIVACY_LLM_MAX_CONCURRENCY=1
# 请求等待推理槽位的最长秒数，超时自动降级（默认 30）
# PRIVACY_LLM_SEMAPHORE_WAIT_SECONDS=30
# 可用内存低于该阈值（MB）时跳过 LLM 层（默认 512）
# PRIVACY_LLM_MIN_FREE_MEM_MB=512
# VLM/LLM 单次推理超时秒数（默认 180）
# PRIVACY_VLM_TIMEOUT=180
# LLM 后端选择（auto/pytorch/vllm/mlx/openai，默认 auto）
# PRIVACY_LLM_BACKEND=auto

# ------------------------------------------------------------------------------
# 图片打码与网关 / Image Redaction & Gateway
# ------------------------------------------------------------------------------
# 图片打码允许读取的目录白名单（os.pathsep 分隔，默认 cwd + 系统临时目录）
# PRIVACY_IMAGE_ALLOWED_DIRS=/data/images
# 网关配置文件路径（仅 gateway 模式使用）
# PRIVACY_GATEWAY_CONFIG=config/gateway.yaml
