# ==============================================================================
# llmlora / Qwen Privacy LoRA 训练配置文件（适合本地 NVIDIA RTX 5060 显卡）
# Hardware Profile: NVIDIA RTX 5060 (8GB/12GB VRAM, BF16 Acceleration)
# Target Training Duration: ~4 Hours
# ==============================================================================

# 1. 路径与目录配置 / Paths & Directories
LLMLORA_BASE_MODEL=llmlora/basemodels/cmeee_merged
LLMLORA_RULES_DIR=rules
LLMLORA_DATA_DIR=llmlora/data
LLMLORA_OUTPUT_DIR=llmlora/output/saves/qwen35-cmeee-privacy-lora
LLMLORA_MERGED_OUTPUT_DIR=llmlora/output/models/qwen35-cmeee-privacy-merged

# 2. 训练超参数（针对 5060 算力与 ~4 小时训练时长全额优化）
# Training Hyperparameters: ~4 Hours, 10 Epochs
LLMLORA_NUM_EPOCHS=10
LLMLORA_MAX_STEPS=-1
LLMLORA_BATCH_SIZE=4
LLMLORA_GRAD_ACCUM_STEPS=4
LLMLORA_LEARNING_RATE=2e-4
LLMLORA_WARMUP_RATIO=0.05
LLMLORA_WEIGHT_DECAY=0.01
LLMLORA_MAX_LENGTH=512
LLMLORA_LOGGING_STEPS=10
LLMLORA_EVAL_STEPS=50
LLMLORA_SAVE_STEPS=50
LLMLORA_SAVE_TOTAL_LIMIT=3
LLMLORA_DATALOADER_NUM_WORKERS=4
LLMLORA_SEED=42

# 3. PEFT LoRA 配置（在 5060 显存允许下提升秩 r=32 / alpha=64，提升学习容量）
# LoRA Configuration (Rank r=32, Alpha=64)
LLMLORA_LORA_R=32
LLMLORA_LORA_ALPHA=64
LLMLORA_LORA_DROPOUT=0.05

# 4. 优化器与硬件加速配置 / Optimizer & Hardware Settings
LLMLORA_OPTIM=adamw_torch
LLMLORA_DTYPE=auto
LLMLORA_GRADIENT_CHECKPOINTING=true
LLMLORA_MERGE_ON_COMPLETION=true
LLMLORA_MAX_SHARD_SIZE=2GB
